push 1758427767 #Iron ore 17
push 1830218956 #Nickel ore 18
push -82508479 #Solder 19
push 1758427767 #Iron ore 20
push -190236170 #Lead ore 21
push -654790771 #Steel 22
push 1758427767 #Iron ore 23
push 1758427767 #Iron ore 24
push 1758427767 #Iron ore 25
push 1724793494 #Coal ore 26
push 412924554 #Astroloy 27
push -707307845 #Copper ore 28
push -654790771 #Steel 29
push -654790771 #Steel 30
push -983091249 #Cobalt ore 31
push 1579842814 #Hastelloy 32
