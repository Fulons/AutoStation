push -916518678 #Silver ore 48
push 1830218956 #Nickel ore 49
push -190236170 #Lead ore 50
push -190236170 #Lead ore 51
alias transmitter d0
selectIngot:
yield
lbn r0 554524804 HASH("selectDial") Setting Maximum
get r1 db r0 #Get product pointer
add r1 r1 r15 #Apply pointer offset
get r14 db r1 #Get product hash
move r11 0 #ingredient1
move r12 0 #ingredient2
move r13 0 #ingredient3
add r1 r1 1
get r10 db r1 #ingredient0
bge r0 9 superAlloys#Super alloys and steel
bge r0 5 alloys #Alloys
order:
sbn -851746783 HASH("product") Setting r14 #Set memory of hash displays
sbn -851746783 HASH("ingredient0") Setting r10 #ingredient0
sbn -851746783 HASH("ingredient1") Setting r11 #ingredient1
sbn -851746783 HASH("ingredient2") Setting r12 #ingredient2
sbn -851746783 HASH("ingredient3") Setting r13 #ingredient3
lbn r0 1220484876 HASH("orderLever") Open Maximum
beqz r0 selectIngot #If lever not open just display ingredients
lbn r9 554524804 HASH("multiplierDial") Setting Maximum
beqz r9 selectIngot #Multiplier is 0, return
sbn 1220484876 HASH("orderLever") Open 0
move r2 r10 #ingredient0
jal waitTransmitt
beqz r11 selectIngot #ingredient1
move r2 r11 #ingredient1
jal waitTransmitt
beqz r12 selectIngot #ingredient2
move r2 r12 #ingredient2
jal waitTransmitt
beqz r13 selectIngot #ingredient3
move r2 r13 #ingredient3
jal waitTransmitt
j selectIngot
superAlloys:
add r1 r1 1
get r11 db r1 #ingredient1
add r1 r1 1
get r12 db r1 #ingredient2
add r1 r1 1
get r13 db r1 #ingredient3
j order
alloys:
add r1 r1 1
get r11 db r1 #ingredient1
j order
waitTransmitt:
beq r2 -654790771 ra #If steel dont request
sll r3 r9 8 #Multiplier sets stack count
sll r2 r2 16 #Hash
or r2 r2 r3
s transmitter Setting r2
yield
l r0 transmitter Setting
bnez r0 waitTransmitt
j ra