push 47 #Waspaloy 47
move r15 sp #Offset
push -404336834 #Copper 0
push -707307845 #Copper ore 1
push 226410516 #Gold 2
push -1348105509 #Gold ore 3
push -1301215609 #Iron 4
push 1758427767 #Iron ore 5
