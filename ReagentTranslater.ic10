alias reagantTranslater r15
lbn reagantTranslater 2037291645 HASH("ReagantTranslater") ReferenceId Maximum #Compact housing
#lbn reagantTranslater -128473777 HASH("ReagantTranslater") ReferenceId Maximum #Housing

alias requestReagent r14
alias currentReagent r13
alias currentIngot r12
alias index r11
alias prevReagent r10
move prevReagent 0
lookup:
yield
l requestReagent reagantTranslater Setting
sll requestReagent requestReagent 22
sra requestReagent requestReagent 22 #requestReagent (signed)
beq requestReagent prevReagent lookup
move prevReagent requestReagent
beqz requestReagent lookup
move index 0
lookupLoop:
bge index sp notFound
get currentReagent db index #Reagant
add index index 1
get currentIngot db index #Ingot
add index index 1
bne currentReagent requestReagent lookupLoop #Loop if not found
s reagantTranslater Setting currentIngot
move prevReagent currentIngot
s db Setting 1111
j lookup

notFound:
s reagantTranslater Setting 0
move prevReagent 0
s db Setting 2000
j lookup