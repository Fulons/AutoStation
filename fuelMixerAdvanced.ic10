alias desiredRatio r15
alias MethaneAnalyzer d0
alias O2Analyzer d1
alias FuelAnalyzer d2
alias FuelMixer d3

define maxFuelPressure 30000 #30mpa

define partsGas1 1 #Oxygen
define partsGas2 2 #Methane

add desiredRatio partsGas1 partsGas2
div desiredRatio partsGas1 desiredRatio

main:
yield
sub r0 1 desiredRatio
div r0 desiredRatio r0 # a
l r1 MethaneAnalyzer Temperature
l r2 O2Analyzer Temperature
div r1 r1 r2
mul r0 r0 r1 # b
add r1 r0 1
div r0 r0 r1 # s
mul r0 r0 100 #actual ratio
s FuelMixer Setting r0
l r0 FuelAnalyzer Pressure
l r1 MethaneAnalyzer Pressure
l r2 O2Analyzer Pressure
add r1 r1 r2
sge r1 r1 r0
slt r0 r0 maxFuelPressure
and r0 r0 r1
s FuelMixer On r0
j main